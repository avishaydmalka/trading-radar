# ======================= רדאר מסחר – הגדרות =======================
# העתק לקובץ .env ומלא. כל המפתחות חינמיים. רק שורות עם ★ חובה.

# --- כללי ---
DEMO_MODE=0                       # 1 = נתונים סינתטיים להדגמה
BASE_CURRENCY=USD                 # USD או ILS – מטבע הצגת התיק
DOMAIN=radar.example.duckdns.org  # ★ הדומיין שלך (ל-HTTPS)
PUBLIC_URL=https://radar.example.duckdns.org

# --- כניסה לדשבורד ---
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=               # ★ סיסמה חזקה

# --- תדירות ---
SCAN_INTERVAL_MIN=5               # כשבורסה פתוחה
OFFHOURS_INTERVAL_MIN=60          # כשהכל סגור
NEWS_INTERVAL_MIN=15
LLM_INTERVAL_MIN=30               # ניתוח AI מחדש לכל מניה
BRIEF_INTERVAL_MIN=60             # תדריך שוק
LLM_MAX_CALLS_PER_SCAN=4

# --- מודלי שפה חינמיים (לפחות אחד מומלץ; בלי – ניתוח מבוסס חוקים) ---
LLM_PROVIDERS=gemini,groq,openrouter,ollama
GEMINI_API_KEY=                   # https://aistudio.google.com/apikey
GEMINI_MODEL=gemini-3.5-flash,auto   # first choice, then the newest stable Flash
GROQ_API_KEY=                     # https://console.groq.com/keys
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=               # https://openrouter.ai/keys (מודלים ‎:free)
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OLLAMA_URL=                       # למשל http://ollama:11434 אם מריצים מודל מקומי
OLLAMA_MODEL=llama3.1:8b

# --- טלגרם ---
TELEGRAM_BOT_TOKEN=               # מ-@BotFather
TELEGRAM_CHAT_ID=                 # שלח /start לבוט והוא יחזיר לך את המספר

# --- Push לטלפון/דפדפן (python -m app.tools.gen_vapid) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:you@example.com

# --- התראות ---
ALERT_COOLDOWN_HOURS=6            # לא לחזור על אותה התראה לפני
MIN_OPPORTUNITY_SCORE=55          # סף ציון להתראת הזדמנות

# --- נתונים נוספים (אופציונלי) ---
FINNHUB_API_KEY=                  # חדשות חברות נוספות – finnhub.io
CONGRESS_API_URL=https://www.bargo.ai/free-apis/congress/v1/trades
CONGRESS_API_KEY=

# --- ברוקר (אופציונלי, Paper בלבד מומלץ) ---
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
